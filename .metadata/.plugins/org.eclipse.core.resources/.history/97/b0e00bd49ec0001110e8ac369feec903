<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>BookMyTicket</title>

    <link rel="stylesheet"
          href="style.css">

</head>

<body>

    <!-- HEADER -->

    <header>

        <div class="logo">
            🚌 BookMyTicket
        </div>

        <nav>

            <a href="#home">Home</a>

            <a href="#search">Search Buses</a>

            <a href="#login">Login</a>

        </nav>

    </header>


    <!-- HOME -->

    <section id="home"
             class="hero">

        <div class="hero-content">

            <h1>
                Book Your Bus Ticket
                <br>
                Easily & Quickly
            </h1>

            <p>
                Search buses and find your perfect journey.
            </p>

            <button
                type="button"
                onclick="goToSearch()">

                Search Buses

            </button>

        </div>

    </section>


    <!-- SEARCH -->

    <section id="search"
             class="search-section">

        <h2>
            Search Available Buses
        </h2>

        <p>
            Enter your boarding and destination points.
        </p>


        <div class="search-box">

            <div class="input-group">

                <label for="from">
                    Boarding Point
                </label>

                <input
                    type="text"
                    id="from"
                    placeholder="Example: Hyderabad">

            </div>


            <div class="input-group">

                <label for="to">
                    Destination
                </label>

                <input
                    type="text"
                    id="to"
                    placeholder="Example: Vijayawada">

            </div>


            <button
                type="button"
                onclick="searchBuses()">

                🔍 Search Buses

            </button>

        </div>


        <!-- RESULTS -->

        <div id="results">

        </div>

    </section>


    <!-- LOGIN -->

    <section id="login"
             class="login-section">

        <div class="login-box">

            <h2>
                Login
            </h2>

            <p>
                Login to BookMyTicket
            </p>

            <input
                type="text"
                id="username"
                placeholder="Username">

            <input
                type="password"
                id="password"
                placeholder="Password">

            <button
                type="button"
                onclick="loginUser()">

                Login

            </button>

            <p id="loginMessage"></p>

        </div>

    </section>


    <!-- FOOTER -->

    <footer>

        <p>
            © 2026 BookMyTicket
        </p>

    </footer>


    <!-- JAVASCRIPT -->

    <script src="app.js"></script>

</body>

</html>
