<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookMyTicket</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="style.css">
</head>

<body>

<!-- ================= NAVBAR ================= -->

<header class="navbar">
    <div class="logo">
        <span class="logo-icon">🚌</span>
        <span>BookMy<span>Ticket</span></span>
    </div>

    <nav>
        <a href="#home">Home</a>
        <a href="#booking">Book Ticket</a>
        <a href="#about">About</a>
    </nav>

    <div class="nav-buttons">
        <button class="btn btn-outline" onclick="openModal('loginModal')">
            Login
        </button>

        <button class="btn btn-primary" onclick="openModal('signupModal')">
            Sign Up
        </button>
    </div>

    <button class="mobile-menu" onclick="toggleMenu()">☰</button>
</header>


<!-- ================= HERO ================= -->

<section class="hero" id="home">

    <div class="hero-content">

        <div class="hero-text">
            <div class="badge">🚀 Fast & Easy Bus Booking</div>

            <h1>
                Travel anywhere.<br>
                <span>Book your journey.</span>
            </h1>

            <p>
                Find comfortable buses, choose your favourite seats
                and book your tickets in just a few clicks.
            </p>

            <button class="hero-btn" onclick="scrollToBooking()">
                Book Your Ticket →
            </button>
        </div>

        <div class="hero-bus">
            <div class="bus-glow"></div>
            <div class="bus-emoji">🚌</div>
        </div>

    </div>

</section>


<!-- ================= BOOKING SEARCH ================= -->

<section class="booking-section" id="booking">

    <div class="section-heading">
        <span class="small-title">PLAN YOUR JOURNEY</span>
        <h2>Where are you going?</h2>
        <p>Enter your journey details to find available buses.</p>
    </div>

    <div class="search-card">

        <div class="location-box">
            <label>FROM</label>

            <div class="input-wrapper">
                <span>📍</span>
                <input
                    type="text"
                    id="fromLocation"
                    placeholder="Boarding point"
                >
            </div>
        </div>

        <button class="swap-btn" onclick="swapLocations()" title="Swap locations">
            ⇄
        </button>

        <div class="location-box">
            <label>TO</label>

            <div class="input-wrapper">
                <span>📍</span>
                <input
                    type="text"
                    id="toLocation"
                    placeholder="Departure point"
                >
            </div>
        </div>

        <button class="search-btn" onclick="searchBuses()">
            Search Buses
        </button>

    </div>

</section>


<!-- ================= BUS RESULTS ================= -->

<section class="results-section" id="resultsSection">

    <div class="results-header">
        <div>
            <span class="small-title">AVAILABLE BUSES</span>
            <h2 id="routeTitle">Available Buses</h2>
        </div>

        <span class="bus-count" id="busCount"></span>
    </div>

    <div id="busResults" class="bus-results"></div>

</section>


<!-- ================= SEAT BOOKING ================= -->

<section class="seat-section" id="seatSection">

    <div class="section-heading">
        <span class="small-title">SELECT YOUR SEAT</span>
        <h2>Choose your favourite seats</h2>
        <p>You can select up to 5 seats.</p>
    </div>

    <div class="seat-layout-wrapper">

        <div class="bus-layout">

            <div class="driver-area">
                <span>🛞</span>
                <small>Driver</small>
            </div>

            <div class="seat-grid" id="seatGrid">
                <!-- Seats generated by JavaScript -->
            </div>

            <div class="seat-legend">

                <div>
                    <span class="legend-seat available"></span>
                    Available
                </div>

                <div>
                    <span class="legend-seat selected"></span>
                    Selected
                </div>

                <div>
                    <span class="legend-seat booked"></span>
                    Booked
                </div>

            </div>

        </div>


        <!-- BOOKING SUMMARY -->

        <div class="booking-summary">

            <h3>Booking Summary</h3>

            <div class="route-summary">
                <div>
                    <small>FROM</small>
                    <strong id="summaryFrom">-</strong>
                </div>

                <div class="route-arrow">→</div>

                <div>
                    <small>TO</small>
                    <strong id="summaryTo">-</strong>
                </div>
            </div>

            <div class="summary-line">
                <span>Bus</span>
                <strong id="summaryBus">-</strong>
            </div>

            <div class="summary-line">
                <span>Seats</span>
                <strong id="selectedSeatsText">None</strong>
            </div>

            <div class="summary-line">
                <span>Number of seats</span>
                <strong id="seatCount">0</strong>
            </div>

            <hr>

            <div class="summary-line">
                <span>Ticket price</span>
                <strong>₹<span id="ticketPrice">0</span></strong>
            </div>

            <div class="summary-line">
                <span>Convenience fee</span>
                <strong>₹<span id="convenienceFee">0</span></strong>
            </div>

            <div class="total-line">
                <span>Total</span>
                <strong>₹<span id="totalPrice">0</span></strong>
            </div>

            <button class="confirm-btn" onclick="confirmBooking()">
                Confirm Booking
            </button>

        </div>

    </div>

</section>


<!-- ================= ABOUT ================= -->

<section class="about-section" id="about">

    <div class="about-content">

        <div>
            <span class="small-title">ABOUT US</span>

            <h2>Making bus travel simpler.</h2>

            <p>
                BookMyTicket is a simple bus ticket booking system designed
                to make your journey planning fast, convenient and easy.
            </p>

            <p>
                Search for your route, find available buses, select your
                seats and get your booking summary instantly.
            </p>
        </div>

        <div class="features">

            <div class="feature">
                <div class="feature-icon">🔍</div>
                <h3>Easy Search</h3>
                <p>Find buses between your locations quickly.</p>
            </div>

            <div class="feature">
                <div class="feature-icon">💺</div>
                <h3>Seat Selection</h3>
                <p>Select your preferred seats visually.</p>
            </div>

            <div class="feature">
                <div class="feature-icon">💳</div>
                <h3>Simple Pricing</h3>
                <p>See your complete fare before booking.</p>
            </div>

        </div>

    </div>

</section>


<!-- ================= FOOTER ================= -->

<footer>

    <div class="footer-logo">
        🚌 BookMyTicket
    </div>

    <p>
        © 2026 BookMyTicket. All rights reserved.
    </p>

</footer>


<!-- ================= LOGIN MODAL ================= -->

<div class="modal-overlay" id="loginModal">

    <div class="modal">

        <button class="close-btn" onclick="closeModal('loginModal')">
            ×
        </button>

        <div class="modal-icon">🔐</div>

        <h2>Welcome Back!</h2>

        <p>Login to continue booking your ticket.</p>

        <form onsubmit="login(event)">

            <label>Username</label>

            <input
                type="text"
                id="loginUsername"
                placeholder="Enter username"
                required
            >

            <label>Password</label>

            <input
                type="password"
                id="loginPassword"
                placeholder="Enter password"
                required
            >

            <button class="modal-submit" type="submit">
                Login
            </button>

        </form>

        <p class="modal-footer-text">
            Don't have an account?
            <button onclick="switchModal('loginModal','signupModal')">
                Sign Up
            </button>
        </p>

    </div>

</div>


<!-- ================= SIGNUP MODAL ================= -->

<div class="modal-overlay" id="signupModal">

    <div class="modal">

        <button class="close-btn" onclick="closeModal('signupModal')">
            ×
        </button>

        <div class="modal-icon">👤</div>

        <h2>Create Account</h2>

        <p>Sign up to start booking tickets.</p>

        <form onsubmit="signup(event)">

            <label>Username</label>

            <input
                type="text"
                id="signupUsername"
                placeholder="Choose username"
                required
            >

            <label>Password</label>

            <input
                type="password"
                id="signupPassword"
                placeholder="Create password"
                required
            >

            <label>Confirm Password</label>

            <input
                type="password"
                id="confirmPassword"
                placeholder="Confirm password"
                required
            >

            <button class="modal-submit" type="submit">
                Create Account
            </button>

        </form>

        <p class="modal-footer-text">
            Already have an account?
            <button onclick="switchModal('signupModal','loginModal')">
                Login
            </button>
        </p>

    </div>

</div>


<!-- ================= SUCCESS MODAL ================= -->

<div class="modal-overlay" id="successModal">

    <div class="modal success-modal">

        <button class="close-btn" onclick="closeModal('successModal')">
            ×
        </button>

        <div class="success-icon">
            ✓
        </div>

        <h2>Booking Confirmed!</h2>

        <p>Your bus ticket has been successfully booked.</p>

        <div class="ticket-card">

            <div class="ticket-header">
                <span>BOOKMYTICKET</span>
                <span>🎫</span>
            </div>

            <div class="ticket-route">
                <div>
                    <small>FROM</small>
                    <strong id="ticketFrom">-</strong>
                </div>

                <span>→</span>

                <div>
                    <small>TO</small>
                    <strong id="ticketTo">-</strong>
                </div>
            </div>

            <div class="ticket-details">

                <div>
                    <small>BUS</small>
                    <strong id="ticketBus">-</strong>
                </div>

                <div>
                    <small>SEATS</small>
                    <strong id="ticketSeats">-</strong>
                </div>

                <div>
                    <small>TOTAL</small>
                    <strong>₹<span id="ticketTotal">0</span></strong>
                </div>

            </div>

            <div class="ticket-number">
                Booking ID:
                <strong id="bookingId">BMT000000</strong>
            </div>

        </div>

        <button class="modal-submit" onclick="closeModal('successModal')">
            Done
        </button>

    </div>

</div>


<div id="toast"></div>

<script src="app.js"></script>

</body>
</html>