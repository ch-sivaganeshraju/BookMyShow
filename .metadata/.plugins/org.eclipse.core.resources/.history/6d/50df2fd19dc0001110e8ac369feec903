/* =====================================================
   GET ELEMENT
===================================================== */

function get(id) {

    return document.getElementById(id);

}


/* =====================================================
   SCROLL TO BOOKING
===================================================== */

function scrollToBooking() {

    get("booking").scrollIntoView({
        behavior: "smooth"
    });

}


/* =====================================================
   SWAP LOCATIONS
===================================================== */

function swapLocations() {

    const from = get("fromLocation");

    const to = get("toLocation");

    const temp = from.value;

    from.value = to.value;

    to.value = temp;

}


/* =====================================================
   SEARCH BUSES
===================================================== */

function searchBuses() {

    const from =
        get("fromLocation")
            .value
            .trim();

    const to =
        get("toLocation")
            .value
            .trim();


    if (!from || !to) {

        showToast(
            "Please enter both locations."
        );

        return;

    }


    if (
        from.toLowerCase()
        ===
        to.toLowerCase()
    ) {

        showToast(
            "From and To cannot be same."
        );

        return;

    }


    const results =
        buses.filter(function(bus) {

            return (

                bus.from.toLowerCase()
                ===
                from.toLowerCase()

                &&

                bus.to.toLowerCase()
                ===
                to.toLowerCase()

            );

        });


    displayBuses(
        results,
        from,
        to
    );

}


/* =====================================================
   DISPLAY BUSES
===================================================== */

function displayBuses(
    results,
    from,
    to
) {

    const section =
        get("resultsSection");

    const container =
        get("busResults");


    section.classList.add("show");


    get("routeTitle").textContent =
        from + " → " + to;


    get("busCount").textContent =
        results.length
        +
        " bus"
        +
        (
            results.length !== 1
                ? "es"
                : ""
        )
        +
        " found";


    if (results.length === 0) {

        container.innerHTML = `

            <div class="bus-card">

                <div>

                    <h3>
                        🚌 No buses found
                    </h3>

                    <p>
                        Try another route.
                    </p>

                </div>

            </div>

        `;

        return;

    }


    container.innerHTML =
        results.map(function(bus) {

            return `

                <div class="bus-card">


                    <div>

                        <div class="bus-name">
                            ${bus.name}
                        </div>

                        <span class="bus-type">
                            ${bus.type}
                        </span>

                    </div>


                    <div class="bus-info">

                        <div>

                            <div class="bus-time">
                                ${bus.departure}
                            </div>

                            <div class="bus-location">
                                ${bus.from}
                            </div>

                        </div>


                        <div>
                            →
                        </div>


                        <div>

                            <div class="bus-time">
                                ${bus.arrival}
                            </div>

                            <div class="bus-location">
                                ${bus.to}
                            </div>

                        </div>

                    </div>


                    <div>

                        <div class="bus-distance">
                            📍 ${bus.distance} KM
                        </div>

                        <div class="bus-distance">
                            💺 41 seats
                        </div>

                    </div>


                    <div class="bus-fare">

                        <strong>
                            ₹${bus.fare}
                        </strong>

                        <br>

                        <button
                            class="select-bus"
                            onclick="selectBus('${bus.id}')">

                            Select

                        </button>

                    </div>


                </div>

            `;

        }).join("");


    section.scrollIntoView({
        behavior: "smooth"
    });

}


/* =====================================================
   SELECT BUS
===================================================== */

function selectBus(busId) {

    selectedBus =
        buses.find(function(bus) {

            return bus.id === busId;

        });


    if (!selectedBus) {

        return;

    }


    selectedSeats = [];


    get("summaryFrom").textContent =
        selectedBus.from;

    get("summaryTo").textContent =
        selectedBus.to;

    get("summaryBus").textContent =
        selectedBus.name;


    generateSeats();

    updateSummary();


    get("seatSection")
        .classList
        .add("show");


    get("seatSection")
        .scrollIntoView({
            behavior: "smooth"
        });


    showToast(
        selectedBus.name
        +
        " selected."
    );

}


/* =====================================================
   GENERATE SEATS
===================================================== */

function generateSeats() {

    const grid =
        get("seatGrid");


    grid.innerHTML = "";


    let seatNumber = 1;


    /*
        Layout:

        01 02    03 04
        05 06    07 08

        ...

        Last row:

        37 38 39 40 41
    */


    for (
        let row = 0;
        row < 10;
        row++
    ) {


        if (row < 9) {


            createSeat(seatNumber++);

            createSeat(seatNumber++);


            const aisle =
                document.createElement(
                    "div"
                );

            aisle.className =
                "seat aisle";

            grid.appendChild(aisle);


            createSeat(seatNumber++);

            createSeat(seatNumber++);


        } else {


            createSeat(seatNumber++);

            createSeat(seatNumber++);

            createSeat(seatNumber++);

            createSeat(seatNumber++);

            createSeat(seatNumber++);

        }

    }

}


/* =====================================================
   CREATE SEAT
===================================================== */

function createSeat(number) {

    const button =
        document.createElement(
            "button"
        );


    button.className = "seat";


    button.textContent =
        String(number)
            .padStart(2, "0");


    if (
        bookedSeats.includes(number)
    ) {

        button.classList.add(
            "booked"
        );

        button.disabled = true;

    } else {


        button.addEventListener(
            "click",
            function() {

                toggleSeat(
                    number,
                    button
                );

            }
        );

    }


    get("seatGrid")
        .appendChild(button);

}


/* =====================================================
   SELECT / UNSELECT SEAT
===================================================== */

function toggleSeat(
    number,
    button
) {


    if (
        selectedSeats.includes(number)
    ) {


        selectedSeats =
            selectedSeats.filter(
                function(seat) {

                    return seat !== number;

                }
            );


        button.classList.remove(
            "selected"
        );


    } else {


        if (
            selectedSeats.length >= 5
        ) {

            showToast(
                "Maximum 5 seats allowed."
            );

            return;

        }


        selectedSeats.push(number);


        button.classList.add(
            "selected"
        );

    }


    updateSummary();

}


/* =====================================================
   UPDATE SUMMARY
===================================================== */

function updateSummary() {

    if (!selectedBus) {

        return;

    }


    const numberOfSeats =
        selectedSeats.length;


    const ticketPrice =
        selectedBus.fare
        *
        numberOfSeats;


    const convenienceFee =
        12
        *
        numberOfSeats;


    const total =
        ticketPrice
        +
        convenienceFee;


    get("seatCount").textContent =
        numberOfSeats;


    if (
        selectedSeats.length === 0
    ) {

        get("selectedSeatsText")
            .textContent = "None";

    } else {


        get("selectedSeatsText")
            .textContent =

            selectedSeats
                .slice()
                .sort(
                    function(a, b) {
                        return a - b;
                    }
                )
                .map(
                    function(number) {

                        return String(number)
                            .padStart(2, "0");

                    }
                )
                .join(", ");

    }


    get("ticketPrice")
        .textContent =
        ticketPrice;


    get("convenienceFee")
        .textContent =
        convenienceFee;


    get("totalPrice")
        .textContent =
        total;

}


/* =====================================================
   CONFIRM BOOKING
===================================================== */

function confirmBooking() {


    if (!selectedBus) {

        showToast(
            "Please select a bus."
        );

        return;

    }


    if (
        selectedSeats.length === 0
    ) {

        showToast(
            "Please select at least one seat."
        );

        return;

    }


    const total =

        selectedBus.fare
        *
        selectedSeats.length

        +

        12
        *
        selectedSeats.length;


    get("ticketFrom")
        .textContent =
        selectedBus.from;


    get("ticketTo")
        .textContent =
        selectedBus.to;


    get("ticketBus")
        .textContent =
        selectedBus.name;


    get("ticketSeats")
        .textContent =

        selectedSeats
            .slice()
            .sort(
                function(a, b) {
                    return a - b;
                }
            )
            .map(
                function(number) {

                    return String(number)
                        .padStart(2, "0");

                }
            )
            .join(", ");


    get("ticketTotal")
        .textContent =
        total;


    get("bookingId")
        .textContent =
        generateBookingId();


    openModal(
        "successModal"
    );

}


/* =====================================================
   GENERATE BOOKING ID
===================================================== */

function generateBookingId() {

    const number =
        Math.floor(
            100000
            +
            Math.random()
            *
            900000
        );


    return "BMT" + number;

}


/* =====================================================
   LOGIN
===================================================== */

function login(event) {

    event.preventDefault();


    const username =
        get("loginUsername")
            .value
            .trim();


    const password =
        get("loginPassword")
            .value;


    if (!username || !password) {

        showToast(
            "Enter username and password."
        );

        return;

    }


    /*
        TEMPORARY LOGIN.

        Later we will connect this
        to your Java login method.
    */


    showToast(
        "Login successful!"
    );


    closeModal(
        "loginModal"
    );


    event.target.reset();

}


/* =====================================================
   SIGNUP
===================================================== */

function signup(event) {

    event.preventDefault();


    const username =
        get("signupUsername")
            .value
            .trim();


    const password =
        get("signupPassword")
            .value;


    const confirmPassword =
        get("confirmPassword")
            .value;


    if (
        password !==
        confirmPassword
    ) {

        showToast(
            "Passwords do not match."
        );

        return;

    }


    if (
        password.length < 4
    ) {

        showToast(
            "Password must contain at least 4 characters."
        );

        return;

    }


    /*
        TEMPORARY SIGNUP.

        Later this will connect
        to your Java signup method.
    */


    showToast(
        "Account created successfully!"
    );


    closeModal(
        "signupModal"
    );


    event.target.reset();


    setTimeout(
        function() {

            openModal(
                "loginModal"
            );

        },
        500
    );

}


/* =====================================================
   OPEN MODAL
===================================================== */

function openModal(id) {

    const modal =
        get(id);


    if (modal) {

        modal.classList.add(
            "active"
        );

    }

}


/* =====================================================
   CLOSE MODAL
===================================================== */

function closeModal(id) {

    const modal =
        get(id);


    if (modal) {

        modal.classList.remove(
            "active"
        );

    }

}


/* =====================================================
   SWITCH MODALS
===================================================== */

function switchModal(
    current,
    next
) {

    closeModal(current);


    setTimeout(
        function() {

            openModal(next);

        },
        100
    );

}


/* =====================================================
   CLOSE MODAL OUTSIDE
===================================================== */

document.addEventListener(
    "click",
    function(event) {


        if (
            event.target.classList
                .contains(
                    "modal-overlay"
                )
        ) {

            event.target.classList
                .remove(
                    "active"
                );

        }

    }
);


/* =====================================================
