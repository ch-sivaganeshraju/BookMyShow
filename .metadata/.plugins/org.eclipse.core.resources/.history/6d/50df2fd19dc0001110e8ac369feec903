===================================================== */

function toggleMenu() {

    const nav =
        document.querySelector(
            ".navbar nav"
        );


    const buttons =
        document.querySelector(
            ".nav-buttons"
        );


    if (
        nav.style.display === "flex"
    ) {

        nav.style.display = "";

        buttons.style.display = "";

        return;

    }


    nav.style.display = "flex";

    buttons.style.display = "flex";


