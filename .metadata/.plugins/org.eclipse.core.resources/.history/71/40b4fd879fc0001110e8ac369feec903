@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', sans-serif;
    background: #f7f9fc;
    color: #172033;
}


/* =========================
   HEADER
========================= */

header {
    height: 72px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(15px);

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 7%;

    position: sticky;
    top: 0;
    z-index: 1000;

    border-bottom: 1px solid #edf0f5;
}

.logo {
    font-size: 23px;
    font-weight: 800;
    color: #e53935;
}

nav {
    display: flex;
    gap: 35px;
}

nav a {
    text-decoration: none;
    color: #4a5568;
    font-size: 14px;
    font-weight: 600;

    transition: 0.2s;
}

nav a:hover {
    color: #e53935;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 530px;

    display: flex;
    align-items: center;

    padding: 70px 7%;

    background:
        linear-gradient(
            90deg,
            rgba(15, 23, 42, 0.95),
            rgba(15, 23, 42, 0.72),
            rgba(15, 23, 42, 0.35)
        ),
        url("https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1800&q=85");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 650px;
    color: white;
}

.hero-content h1 {
    font-size: 58px;
    line-height: 1.08;
    font-weight: 800;

    letter-spacing: -2px;

    margin-bottom: 22px;
}

.hero-content p {
    font-size: 18px;
    color: #e2e8f0;

    margin-bottom: 35px;
}

.hero-content button {
    background: #e53935;
    color: white;

    border: none;
    border-radius: 10px;

    padding: 15px 28px;

    font-size: 15px;
    font-weight: 700;

    cursor: pointer;

    transition: 0.25s;
}

.hero-content button:hover {
    background: #c62828;
    transform: translateY(-2px);

    box-shadow:
        0 10px 25px rgba(229, 57, 53, 0.3);
}


/* =========================
   SEARCH SECTION
========================= */

.search-section {
    padding: 80px 7% 90px;

    background: #f7f9fc;
}

.search-section > h2 {
    text-align: center;

    font-size: 34px;
    font-weight: 800;

    color: #172033;

    margin-bottom: 10px;
}

.search-section > p {
    text-align: center;

    color: #64748b;

    margin-bottom: 40px;
}


/* =========================
   SEARCH BOX
========================= */

.search-box {
    max-width: 1050px;

    margin: 0 auto;

    background: white;

    padding: 28px;

    border-radius: 18px;

    display: grid;

    grid-template-columns:
        1fr
        1fr
        auto;

    gap: 18px;

    align-items: end;

    box-shadow:
        0 15px 45px rgba(15, 23, 42, 0.09);

    border: 1px solid #edf0f5;
}

.input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.input-group label {
    font-size: 12px;

    font-weight: 700;

    color: #64748b;

    text-transform: uppercase;

    letter-spacing: 0.5px;
}

.input-group input {
    width: 100%;

    height: 52px;

    padding: 0 16px;

    border: 1px solid #dce2ea;

    border-radius: 10px;

    font-family: inherit;

    font-size: 14px;

    outline: none;

    color: #172033;

    background: #fafbfc;

    transition: 0.2s;
}

.input-group input:focus {
    border-color: #e53935;

    background: white;

    box-shadow:
        0 0 0 3px rgba(229, 57, 53, 0.08);
}


/* SEARCH BUTTON */

.search-box button {
    height: 52px;

    padding: 0 27px;

    background: #e53935;

    color: white;

    border: none;

    border-radius: 10px;

    font-family: inherit;

    font-size: 14px;

    font-weight: 700;

    cursor: pointer;

    transition: 0.25s;
}

.search-box button:hover {
    background: #c62828;

    transform: translateY(-1px);

    box-shadow:
        0 8px 20px rgba(229, 57, 53, 0.25);
}


/* =========================
   RESULTS
========================= */

#results {
    max-width: 1050px;

    margin: 35px auto 0;
}

.bus {
    background: white;

    padding: 25px;

    margin-bottom: 16px;

    border-radius: 15px;

    border: 1px solid #edf0f5;

    box-shadow:
        0 8px 25px rgba(15, 23, 42, 0.05);

    transition: 0.25s;
}

.bus:hover {
    transform: translateY(-3px);

    box-shadow:
        0 15px 35px rgba(15, 23, 42, 0.09);

    border-color: #e53935;
}

.bus h3 {
    font-size: 18px;

    color: #172033;

    margin-bottom: 18px;
}

.bus p {
    display: inline-block;

    margin-right: 25px;
    margin-bottom: 12px;

    color: #64748b;

    font-size: 14px;
}

.bus p b {
    color: #334155;
}


/* =========================
   LOGIN
========================= */

.login-section {
    min-height: 600px;

    display: flex;

    justify-content: center;

    align-items: center;

    padding: 80px 20px;

    background:
        linear-gradient(
            135deg,
            #fff5f5,
            #f7f9fc
        );
}

.login-box {
    width: 100%;

    max-width: 420px;

    background: white;

    padding: 40px;

    border-radius: 20px;

    box-shadow:
        0 20px 55px rgba(15, 23, 42, 0.09);

    border: 1px solid #edf0f5;
}

.login-box h2 {
    text-align: center;

    font-size: 30px;

    margin-bottom: 8px;
}

.login-box > p {
    text-align: center;

    color: #64748b;

    margin-bottom: 30px;

    font-size: 14px;
}

.login-box input {
    width: 100%;

    height: 52px;

    margin-bottom: 15px;

    padding: 0 16px;

    border: 1px solid #dce2ea;

    border-radius: 10px;

    outline: none;

    font-family: inherit;

    font-size: 14px;
}

.login-box input:focus {
    border-color: #e53935;

    box-shadow:
        0 0 0 3px rgba(229, 57, 53, 0.08);
}

.login-box button {
    width: 100%;

    height: 52px;

    border: none;

    border-radius: 10px;

    background: #e53935;

    color: white;

    font-family: inherit;

    font-size: 15px;

    font-weight: 700;

    cursor: pointer;

    transition: 0.25s;
}

.login-box button:hover {
    background: #c62828;

    transform: translateY(-1px);
}

#loginMessage {
    margin-top: 15px;

    text-align: center;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #111827;

    color: #94a3b8;

    text-align: center;

    padding: 28px;

    font-size: 13px;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 800px) {

    header {
        padding: 0 5%;
    }

    nav {
        gap: 15px;
    }

    .hero {
        min-height: 500px;

        padding: 60px 6%;
    }

    .hero-content h1 {
        font-size: 42px;
    }

    .search-box {
        grid-template-columns: 1fr;
    }

    .search-box button {
        width: 100%;
    }

}


@media (max-width: 500px) {

    header {
        height: auto;

        padding: 18px 5%;

        flex-direction: column;

        gap: 15px;
    }

    nav {
        gap: 18px;
    }

    .hero-content h1 {
        font-size: 35px;
    }

    .hero-content p {
        font-size: 16px;
    }

    .search-section {
        padding: 55px 5%;
    }

    .search-section > h2 {
        font-size: 27px;
    }

    .login-box {
        padding: 28px 22px;
    }

}
