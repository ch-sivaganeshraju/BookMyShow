* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f7f8fc;
    color: #172033;
}

button,
input {
    font-family: inherit;
}

button {
    cursor: pointer;
}

a {
    text-decoration: none;
}


/* ================= NAVBAR ================= */

.navbar {
    height: 75px;
    background: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    border-bottom: 1px solid #eeeeee;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 22px;
    font-weight: bold;
}

.logo span {
    color: #ff4d30;
}

.navbar nav {
    display: flex;
    gap: 30px;
}

.navbar nav a {
    color: #555;
    font-size: 14px;
    font-weight: bold;
}

.navbar nav a:hover {
    color: #ff4d30;
}

.nav-buttons {
    display: flex;
    gap: 10px;
}

.btn {
    padding: 10px 18px;
    border-radius: 7px;
    font-weight: bold;
}

.outline {
    background: white;
    color: #ff4d30;
    border: 1px solid #ff4d30;
}

.primary {
    background: #ff4d30;
    color: white;
    border: 1px solid #ff4d30;
}

.mobile-menu {
    display: none;
    border: none;
    background: none;
    font-size: 25px;
}


/* ================= HERO ================= */

.hero {
    min-height: 520px;
    background: linear-gradient(
        135deg,
        white,
        #fff5f1
    );

    display: flex;
    align-items: center;
}

.hero-content {
    width: 86%;
    max-width: 1200px;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hero-text {
    max-width: 650px;
}

.badge {
    display: inline-block;
    background: #fff0eb;
    color: #ff4d30;
    padding: 8px 15px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: 60px;
    line-height: 1.1;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #ff4d30;
}

.hero p {
    color: #6b7280;
    font-size: 17px;
    line-height: 1.7;
    max-width: 550px;
    margin-bottom: 30px;
}

.hero-btn {
    background: #ff4d30;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 15px 25px;
    font-weight: bold;
    font-size: 15px;
}

.hero-btn:hover {
    background: #e83d20;
}

.hero-bus {
    font-size: 220px;
}


/* ================= COMMON ================= */

.booking-section,
.results-section,
.seat-section,
.about-section {
    padding: 80px 7%;
}

.section-heading {
    text-align: center;
    margin-bottom: 40px;
}

.small-title {
    color: #ff4d30;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}

.section-heading h2 {
    font-size: 34px;
    margin: 10px 0;
}

.section-heading p {
    color: #777;
}


/* ================= SEARCH ================= */

.search-card {
    max-width: 1100px;
    margin: auto;
    background: white;
    padding: 25px;
    border-radius: 16px;

    display: flex;
    align-items: end;
    gap: 15px;

    box-shadow: 0 10px 35px rgba(
        0,
        0,
        0,
        0.08
    );
}

.location-box {
    flex: 1;
}

.location-box label {
    display: block;
    font-size: 11px;
    font-weight: bold;
    color: #888;
    margin-bottom: 8px;
}

.input-wrapper {
    height: 52px;
    border: 1px solid #ddd;
    border-radius: 8px;

    display: flex;
    align-items: center;

    gap: 8px;
    padding: 0 12px;
}

.input-wrapper input {
    border: none;
    outline: none;
    width: 100%;
    font-size: 14px;
}

.input-wrapper:focus-within {
    border-color: #ff4d30;
}

.swap-btn {
    width: 40px;
    height: 40px;

    border-radius: 50%;
    border: 1px solid #ffcdc2;

    color: #ff4d30;
    background: #fff5f2;

    font-size: 20px;
}

.search-btn {
    height: 52px;
    padding: 0 25px;

    border: none;
    border-radius: 8px;

    background: #ff4d30;
    color: white;

    font-weight: bold;
}


/* ================= RESULTS ================= */

.results-section {
    display: none;
    background: #f0f2f6;
}

.results-section.show {
    display: block;
}

.results-header {
    max-width: 1100px;
    margin: auto auto 30px;

    display: flex;
    justify-content: space-between;
}

.results-header h2 {
    margin-top: 7px;
}

.bus-count {
    background: white;
    padding: 10px 15px;
    border-radius: 7px;

    color: #ff4d30;
    font-weight: bold;
    font-size: 13px;
}

.bus-results {
    max-width: 1100px;
    margin: auto;

    display: grid;
    gap: 15px;
}

.bus-card {
    background: white;
    border-radius: 14px;
    padding: 23px;

    display: grid;
    grid-template-columns:
        1.3fr 1fr 1fr 0.8fr;

    align-items: center;
    gap: 20px;
}

.bus-name {
    font-size: 18px;
    font-weight: bold;
}

.bus-type {
    display: inline-block;

    background: #fff0ec;
    color: #ff4d30;

    padding: 5px 8px;
    border-radius: 5px;

    font-size: 10px;
    font-weight: bold;

    margin-top: 7px;
}

.bus-info {
    display: flex;
    gap: 12px;
}

.bus-time {
    font-weight: bold;
}

.bus-location {
    font-size: 11px;
    color: #888;
    margin-top: 4px;
}

.bus-distance {
    font-size: 13px;
    color: #777;
}

.bus-fare strong {
    font-size: 21px;
}

.select-bus {
    border: none;
    background: #ff4d30;
    color: white;

    padding: 9px 18px;
    border-radius: 6px;

    font-weight: bold;
    margin-top: 8px;
}


/* ================= SEATS ================= */

.seat-section {
    display: none;
    background: white;
}

.seat-section.show {
    display: block;
}

.seat-layout-wrapper {
    max-width: 1000px;
    margin: auto;

    display: grid;
    grid-template-columns: 1fr 360px;

    gap: 45px;
}

.bus-layout {
    max-width: 430px;
    margin: auto;

    background: #f3f5f8;

    border: 2px solid #e0e3e8;
    border-radius: 30px;

    padding: 25px;
}

.driver-area {
    height: 60px;

    border-bottom: 1px dashed #bbb;

    display: flex;
    justify-content: flex-end;
    align-items: center;

    gap: 10px;

    color: #777;
}

.driver-area span {
    font-size: 25px;
}

.seat-grid {
    margin-top: 25px;

    display: grid;

    grid-template-columns:
        repeat(5, 1fr);

    gap: 10px;
}

.seat {
    height: 42px;

    border: 1px solid #ccd0d7;
    border-radius: 7px;

    background: white;
    color: #555;

    font-weight: bold;
    font-size: 11px;
}

.seat:hover:not(.booked) {
    border-color: #ff4d30;
    color: #ff4d30;
}

.seat.selected {
    background: #ff4d30;
    border-color: #ff4d30;
    color: white;
}

.seat.booked {
    background: #d9dde3;
    border-color: #d9dde3;

    color: #999;

    cursor: not-allowed;
}

.seat.aisle {
    visibility: hidden;
}

.seat-legend {
    border-top: 1px dashed #bbb;

    margin-top: 25px;
    padding-top: 20px;

    display: flex;
    justify-content: space-around;

    font-size: 11px;
    color: #777;
}

.legend-seat {
    display: inline-block;

    width: 16px;
    height: 16px;

    border-radius: 4px;

    background: white;
    border: 1px solid #ccc;

    vertical-align: middle;
    margin-right: 5px;
}

.legend-seat.selected {
    background: #ff4d30;
    border-color: #ff4d30;
}

.legend-seat.booked {
    background: #d9dde3;
    border-color: #d9dde3;
}


/* ================= SUMMARY ================= */

.booking-summary {
    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    padding: 25px;

    box-shadow:
        0 10px 30px rgba(
            0,
            0,
            0,
            0.06
        );
}

.booking-summary h3 {
    margin-bottom: 20px;
}

.route-summary {
    background: #fff5f2;

    border-radius: 10px;

    padding: 17px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 25px;
}

.route-summary small {
    display: block;

    color: #999;

    font-size: 9px;
    font-weight: bold;

    margin-bottom: 4px;
}

.route-summary strong {
    font-size: 13px;
}

.route-arrow {
    color: #ff4d30;
}

.summary-line {
    display: flex;
    justify-content: space-between;

    margin: 15px 0;

    font-size: 13px;
    color: #777;
}

.summary-line strong {
    color: #222;
}

.booking-summary hr {
    border: none;
    border-top: 1px solid #eee;

    margin: 20px 0;
}

.total-line {
    display: flex;
    justify-content: space-between;

    font-size: 18px;
    font-weight: bold;

    margin: 20px 0;
}

.total-line strong {
    color: #ff4d30;
    font-size: 24px;
}

.confirm-btn {
    width: 100%;
    height: 50px;

    border: none;
    border-radius: 8px;

    background: #ff4d30;
    color: white;

    font-weight: bold;
}


/* ================= ABOUT ================= */

.about-section {
    background: #111827;
    color: white;
}

.about-content {
    max-width: 1100px;
    margin: auto;

    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 60px;
}

.about-section h2 {
    font-size: 38px;
    margin: 15px 0;
}

.about-section p {
    color: #aeb5c3;
    line-height: 1.7;
    margin-bottom: 10px;
}

.features {
    display: grid;
    gap: 15px;
}

.feature {
    background: #1b2434;
    border: 1px solid #2b3547;

    border-radius: 12px;

    padding: 20px;
}

.feature-icon {
    font-size: 25px;
    margin-bottom: 8px;
}

.feature h3 {
    margin-bottom: 5px;
}


/* ================= FOOTER ================= */

footer {
    background: #0b101a;
    color: #8992a2;

    padding: 25px 7%;

    display: flex;
    justify-content: space-between;
}

.footer-logo {
    color: white;
    font-weight: bold;
}


/* ================= MODAL ================= */

.modal-overlay {
    position: fixed;

    inset: 0;

    background: rgba(
        0,
        0,
        0,
        0.65
    );

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;

    z-index: 2000;
}

.modal-overlay.active {
    display: flex;
}

.modal {
    position: relative;

    width: 100%;
    max-width: 420px;

    background: white;

    border-radius: 18px;

    padding: 32px;
}

.close-btn {
    position: absolute;

    top: 15px;
    right: 15px;

    border: none;

    width: 32px;
    height: 32px;

    border-radius: 50%;

    background: #eee;

    font-size: 20px;
}

.modal-icon {
    width: 55px;
    height: 55px;

    background: #fff0ec;

    border-radius: 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 25px;

    margin-bottom: 15px;
}

.modal h2 {
    margin-bottom: 8px;
}

.modal > p {
    color: #777;
    font-size: 13px;
}

.modal form label {
    display: block;

    font-size: 11px;
    font-weight: bold;

    margin: 15px 0 7px;
}

.modal form input {
    width: 100%;
    height: 46px;

    border: 1px solid #ddd;

    border-radius: 7px;

    padding: 0 12px;

    outline: none;
}

.modal form input:focus {
    border-color: #ff4d30;
}

.modal-submit {
    width: 100%;

    height: 48px;

    margin-top: 20px;

    border: none;
    border-radius: 7px;

    background: #ff4d30;
    color: white;

    font-weight: bold;
}

.modal-footer-text {
    text-align: center;
    margin-top: 20px !important;
}

.modal-footer-text button {
    border: none;
    background: none;
    color: #ff4d30;
    font-weight: bold;
}


/* ================= SUCCESS ================= */

.success-modal {
    text-align: center;
}

.success-icon {
    width: 65px;
    height: 65px;

    background: #e8f8ef;

    color: #18a957;

    border-radius: 50%;

    margin: auto;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 35px;
}

.ticket-card {
    background: #111827;
    color: white;

    border-radius: 14px;

    padding: 20px;

    margin: 20px 0;

    text-align: left;
}

.ticket-header {
    display: flex;
    justify-content: space-between;

    color: #ff846f;

    font-weight: bold;

    font-size: 12px;

    margin-bottom: 20px;
}

.ticket-route {
    display: flex;
    justify-content: space-between;

    border-bottom: 1px dashed #444;

    padding-bottom: 20px;
}

.ticket-route small,
.ticket-details small {
    display: block;

    color: #999;

    font-size: 9px;

    margin-bottom: 5px;
}

.ticket-details {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 10px;

    padding: 20px 0;
}

.ticket-details strong {
    font-size: 12px;
}

.ticket-number {
    border-top: 1px dashed #444;

    padding-top: 15px;

    color: #999;

    font-size: 11px;
}

.ticket-number strong {
    color: white;
}


/* ================= TOAST ================= */

#toast {
    position: fixed;

    right: 25px;
    bottom: 25px;

    background: #172033;
    color: white;

    padding: 14px 20px;

    border-radius: 8px;

    opacity: 0;

    transform: translateY(100px);

    transition: 0.3s;

    z-index: 3000;
}

#toast.show {
    opacity: 1;

    transform: translateY(0);
}


/* ================= MOBILE ================= */

@media(max-width: 900px) {

    .navbar nav,
    .nav-buttons {
        display: none;
    }

    .mobile-menu {
        display: block;
    }

    .hero-content {
        text-align: center;
        justify-content: center;
    }

    .hero-bus {
        display: none;
    }

    .search-card {
        flex-direction: column;
        align-items: stretch;
    }

    .swap-btn {
        align-self: center;
    }

    .bus-card {
        grid-template-columns: 1fr 1fr;
    }

    .seat-layout-wrapper {
        grid-template-columns: 1fr;
    }

    .about-content {
        grid-template-columns: 1fr;
    }
}


@media(max-width: 600px) {

    .hero h1 {
        font-size: 40px;
    }

    .hero {
        min-height: 480px;
    }

    .booking-section,
    .results-section,
    .seat-section,
    .about-section {
        padding: 60px 5%;
    }

    .section-heading h2 {
        font-size: 27px;
    }

    .bus-card {
        grid-template-columns: 1fr;
    }

    .seat-grid {
        gap: 7px;
    }

    .seat {
        height: 38px;
        font-size: 9px;
    }

    .seat-legend {
        flex-direction: column;
        gap: 10px;
    }

    footer {
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }
}